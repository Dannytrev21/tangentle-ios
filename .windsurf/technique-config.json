  "techniques": {
    "tot": {
      "name": "Tree of Thoughts",
      "description": "Explore multiple reasoning paths as a tree, evaluate each branch, prune unpromising ones",
      "promptTemplate": ".windsurf/knowledge/techniques/tot.md",
      "costLevel": "high",
      "bestFor": ["complex decisions", "system design", "exploration", "multiple valid approaches"]
    },
    "got": {
      "name": "Graph of Thoughts",
      "description": "Build a graph of ideas, merge compatible thoughts, refine through aggregation",
      "promptTemplate": ".windsurf/knowledge/techniques/got.md",
      "costLevel": "high",
      "bestFor": ["merging ideas", "refinement", "documentation review", "protocol design"]
    },
    "reflexion": {
      "name": "Reflexion",
      "description": "Attempt, evaluate, reflect on failures, store lessons in memory bank, retry with wisdom",
      "promptTemplate": ".windsurf/knowledge/techniques/reflexion.md",
      "costLevel": "medium",
      "bestFor": ["learning from failures", "self-correction", "debugging", "verification"]
    },
    "self-consistency": {
      "name": "Self-Consistency",
      "description": "Generate multiple independent solutions, select the most consistent answer",
      "promptTemplate": ".windsurf/knowledge/techniques/self-consistency.md",
      "costLevel": "high",
      "bestFor": ["algorithm verification", "system design validation", "correctness checking"]
    },
    "self-refine": {
      "name": "Self-Refine",
      "description": "Generate, get feedback, refine iteratively until quality threshold met",
      "promptTemplate": ".windsurf/knowledge/techniques/self-refine.md",
      "costLevel": "medium",
      "bestFor": ["UI polish", "code quality", "documentation", "iterative improvement"]
    },
    "tdd": {
      "name": "Test-Driven Development",
      "description": "Write failing tests first, implement just enough to pass, then refactor",
      "promptTemplate": ".windsurf/knowledge/techniques/tdd.md",
      "costLevel": "medium",
      "bestFor": ["algorithm implementation", "validation logic", "data access", "service implementation"]
    },
    "react": {
      "name": "ReAct",
      "description": "Reason about actions, take action, observe results, iterate",
      "promptTemplate": ".windsurf/knowledge/techniques/react.md",
      "costLevel": "medium",
      "bestFor": ["debugging", "interactive problem-solving", "API integration", "configuration"]
    },
    "ps-plus": {
      "name": "Plan-and-Solve Plus",
      "description": "Structured planning with problem decomposition and step extraction",
      "promptTemplate": ".windsurf/knowledge/techniques/ps-plus.md",
      "costLevel": "low",
      "bestFor": ["structured planning", "straightforward implementation", "documentation"]
    },
    "chain-of-code": {
      "name": "Chain of Code",
      "description": "Mix semantic reasoning with code execution for complex logic",
      "promptTemplate": ".windsurf/knowledge/techniques/chain-of-code.md",
      "costLevel": "medium",
      "bestFor": ["mixed logic/semantic tasks", "scaffolding", "migration", "E2E tests"]
    },
    "least-to-most": {
      "name": "Least-to-Most",
      "description": "Decompose into subproblems, solve simplest first, build up to complex",
      "promptTemplate": ".windsurf/knowledge/techniques/least-to-most.md",
      "costLevel": "low",
      "bestFor": ["decomposition", "infrastructure setup", "data modeling", "integration tests"]
    }
  },
  "riskLevels": {
    "low": {
      "description": "Low-risk tasks like documentation, configuration, simple UI",
      "retryConfig": {
        "maxSameTechnique": 2,
        "maxAlternative": 1,
        "maxTotal": 3
      }
    },
    "medium": {
      "description": "Medium-risk tasks like service implementation, data access, refactoring",
      "retryConfig": {
        "maxSameTechnique": 3,
        "maxAlternative": 2,
        "maxTotal": 5
      }
    },
    "high": {
      "description": "High-risk tasks like migrations, system design, complex algorithms",
      "retryConfig": {
        "maxSameTechnique": 3,
        "maxAlternative": 3,
        "maxTotal": 7
      }
    },
    "critical": {
      "description": "Critical tasks requiring maximum self-correction (data migrations, security)",
      "retryConfig": {
        "maxSameTechnique": 5,
        "maxAlternative": 5,
        "maxTotal": 10
      }
    }
  },
  "defaults": {
    "unknownProblemType": "new-feature",
    "unknownCategory": "META",
    "defaultRiskLevel": "medium",
    "defaultTechniques": {
      "planning": "tot",
      "implementation": ["self-refine"],
      "verification": "reflexion"
    }
